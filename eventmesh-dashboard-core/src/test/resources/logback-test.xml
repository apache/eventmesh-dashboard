<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <charset>UTF-8</charset>
            <pattern>%d{HH:mm:ss.SSS} %-5level %msg%n%ex</pattern>
        </encoder>
    </appender>

    <!-- Keep test scenarios, inputs, readbacks and JUnit outcomes visible. -->
    <logger name="org.apache.eventmesh.dashboard.core.remoting.kafka.KafkaTestLog" level="INFO"/>
    <logger name="org.apache.eventmesh.dashboard.core.remoting.kafka.live" level="INFO"/>
    <logger name="org.apache.eventmesh.dashboard.core.remoting.kafka.mock" level="INFO"/>

    <!-- Retain diagnostics while suppressing client configuration and protocol chatter. -->
    <root level="WARN">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
